    private async Task EnriquecerTarimasValesMemoriaAsync()
    {
        bool huboCambio = false;
        foreach (var v in _valesTurnoAnterior.Concat(_valesDelTurno).ToList())
        {
            if (v.TotalTarimas == 0 && v.FolioVale > 0 && v.IdRT_Encabezado > 0)
            {
                try
                {
                    var pList = await PalletsService.ObtenerPalletsPorValeAsync(v.FolioVale, v.IdRT_Encabezado);
                    if (pList != null && pList.Count > 0)
                    {
                        v.TotalTarimas = pList.Count;
                        huboCambio = true;
                    }
                }
                catch { }
            }
        }
        if (huboCambio)
        {
            StateHasChanged();
        }
    }

    private async Task CargarTurnoYValesAsync()
    {
        if (_noMaquinaSeleccionada <= 0) { _valesDelTurno = new(); _valesTurnoAnterior = new(); _pallets = new(); _encabezadoActual = null; return; }
        try
        {
            _encabezadoActual = await ValesService.ObtenerEncabezadoCompletoAsync(_noMaquinaSeleccionada, _turnoSeleccionado, _fechaSeleccionada);

            Task<List<ValeDto>> tValesActivos;
            if (_encabezadoActual != null && _encabezadoActual.Encontrado && _encabezadoActual.IdRT_Encabezado > 0)
            {
                tValesActivos = ValesService.ObtenerActivosAsync(_noMaquinaSeleccionada, _turnoSeleccionado, _fechaSeleccionada, _encabezadoActual.IdRT_Encabezado);
            }
            else
            {
                tValesActivos = ValesService.ObtenerActivosAsync(_noMaquinaSeleccionada, _turnoSeleccionado, _fechaSeleccionada);
            }

            var tValesAnteriores = ValesService.ObtenerTurnoAnteriorAsync(_noMaquinaSeleccionada, _turnoSeleccionado, _fechaSeleccionada);

            await Task.WhenAll(tValesActivos, tValesAnteriores);

            _valesDelTurno = await tValesActivos;
            _valesTurnoAnterior = await tValesAnteriores;

            EnriquecerClavesProductosMemoria();

            if (_valesDelTurno.Count > 0)
            {
                if (_esTurnoAnterior && _valesTurnoAnterior.Any(v => v.FolioVale == _folioValeSeleccionado))
                {
                    // Si el operador haba seleccionado un vale del turno anterior explcitamente, lo respetamos
                    var valeAnt = _valesTurnoAnterior.First(v => v.FolioVale == _folioValeSeleccionado);
                    await SeleccionarVale(valeAnt.FolioVale, valeAnt.IdRT_Encabezado);
                }
                else
                {
                    var valeElegido = _valesDelTurno.FirstOrDefault(v => v.FolioVale == _folioValeSeleccionado) ?? _valesDelTurno.First();
                    _esTurnoAnterior = false;
                    _folioValeSeleccionado = valeElegido.FolioVale;
                    await SeleccionarVale(valeElegido.FolioVale, valeElegido.IdRT_Encabezado);
                }
            }
            else if (_esTurnoAnterior && _valesTurnoAnterior.Any(v => v.FolioVale == _folioValeSeleccionado))
            {
                // El operador seleccion explcitamente un vale del turno anterior
                var valeAnt = _valesTurnoAnterior.First(v => v.FolioVale == _folioValeSeleccionado);
                await SeleccionarVale(valeAnt.FolioVale, valeAnt.IdRT_Encabezado);
            }
            else
            {
                // NO auto-seleccionar turno anterior por default. Queda limpio mostrando mensaje informativo.
                _esTurnoAnterior = false;
                _folioValeSeleccionado = 0;
                _valeActual = null;
                _pallets.Clear();
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Error al cargar turno y vales: {ex.Message}", "danger");
        }
    }

