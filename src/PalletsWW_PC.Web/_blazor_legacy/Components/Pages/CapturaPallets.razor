    private static string FormatHora(object? hora)
    {
        if (hora == null) return "--:--";
        if (hora is TimeSpan ts) return ts.ToString(@"hh\:mm");
        if (hora is DateTime dt) return dt.ToString("HH:mm");
        string str = hora.ToString() ?? "";
        return str.Length >= 5 ? str.Substring(0, 5) : str;
    }

