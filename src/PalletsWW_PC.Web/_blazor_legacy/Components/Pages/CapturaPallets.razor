    private async Task ImprimirEtiquetaUsb(int idtblPallets, string? codigoZplPrecalculado = null)
    {
        try
        {
            string? zpl = codigoZplPrecalculado;
            if (string.IsNullOrWhiteSpace(zpl))
            {
                // 1. Obtener código ZPL generado por la base de datos a través de la API
                var etiqueta = await ImpresionService.ObtenerEtiquetaAsync(idtblPallets);
                zpl = etiqueta?.CodigoZpl;
            }

            if (!string.IsNullOrWhiteSpace(zpl))
            {
                // 2. Enviar directamente al microservicio Zebra local en la PC cliente (127.0.0.1:9100)
                try
                {
                    var clientRes = await JS.InvokeAsync<ZebraPrintResultDto>("ZebraPrint.printZpl", zpl);
                    if (clientRes != null && clientRes.Success)
                    {
                        string modoDestino = !string.IsNullOrEmpty(clientRes.Mode) ? clientRes.Mode : "Zebra USB/Red"; MostrarToast($"Etiqueta #{idtblPallets} enviada a {modoDestino}.", "success");
                        _impresoraConectada = true;
                        _impresoraEnPausa = false;
                        return;
                    }
                    else if (clientRes != null && clientRes.IsPaused)
                    {
                        MostrarToast($"Aviso: Impresora en PAUSA con {clientRes.CJobs} trabajo(s) en cola. Despause para imprimir.", "warning");
                        _impresoraEnPausa = true;
                        _trabajosEnCola = clientRes.CJobs;
                        return;
                    }
                }
                catch { }
            }

            // 3. Fallback: Si no responde el puente local cliente, enviar al servicio central del servidor
            var (ok, msg) = await ImpresionService.EnviarAImpresoraUsbAsync(idtblPallets);
            if (ok)
            {
                MostrarToast($"Etiqueta #{idtblPallets} enviada a Zebra USB.", "success");
                _impresoraConectada = true;
            }
            else
            {
                MostrarToast($"Aviso de Impresión: {msg}", "warning");
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Error al imprimir: {ex.Message}", "danger");
        }
    }

    private async Task VerificarImpresoraUsbAsync()
    {
        try
        {
            // 1. Consultar primero al microservicio local en la PC cliente (ZebraPrint.checkStatus en http://127.0.0.1:9100)
            try
            {
                var clientStatus = await JS.InvokeAsync<ZebraStatusDto>("ZebraPrint.checkStatus");
                if (clientStatus != null && clientStatus.Connected)
                {
                    _impresoraConectada = true;
                    _impresoraNombre = !string.IsNullOrWhiteSpace(clientStatus.PrinterName) ? clientStatus.PrinterName : "Zebra USB Local";
                    _impresoraMensaje = clientStatus.Message ?? "Conectada en PC cliente";
                    _impresoraEnPausa = clientStatus.IsPaused;
                    _trabajosEnCola = clientStatus.CJobs;
                    StateHasChanged();
                    return;
                }
                else if (clientStatus != null)
                {
                    _impresoraConectada = false;
                    _impresoraNombre = !string.IsNullOrWhiteSpace(clientStatus.PrinterName) ? clientStatus.PrinterName : "Zebra USB";
                    _impresoraMensaje = clientStatus.Message ?? "No se detectó el Agente Zebra USB en esta PC (127.0.0.1:9100).";
                    _impresoraEnPausa = clientStatus.IsPaused;
                    _trabajosEnCola = clientStatus.CJobs;
                    StateHasChanged();
                    return;
                }
            }
            catch { }

            // 2. Si falló la invocación JS, consultar estado en el servidor como respaldo defensivo
            var est = await ImpresionService.ObtenerEstadoImpresoraAsync();
            if (est.Conectada)
            {
                _impresoraConectada = true;
                _impresoraNombre = string.IsNullOrWhiteSpace(est.NombreImpresora) ? "Zebra USB" : est.NombreImpresora;
                _impresoraMensaje = est.Mensaje ?? "";
                _impresoraEnPausa = false;
                _trabajosEnCola = 0;
            }
            else
            {
                _impresoraConectada = false;
                _impresoraMensaje = "Servicio Zebra USB no detectado en esta PC (127.0.0.1:9100).";
            }
        }
        catch
        {
            _impresoraConectada = false;
            _impresoraMensaje = "No se detectó impresora Zebra";
        }
        StateHasChanged();
    }

    private async Task RefrescarTodo()
    {
        CalcularTurnoYFechaPlanta();
        _cargandoDatos = true;
        try
        {
            var tTurno = CargarTurnoYValesAsync();
            var tProd = CargarProductosMaquinaAsync();
            await Task.WhenAll(tTurno, tProd);
        }
        finally
        {
            _cargandoDatos = false;
        }

        _ = Task.Run(async () =>
        {
            await InvokeAsync(async () =>
            {
                await VerificarImpresoraUsbAsync();
                StateHasChanged();
            });
        });

        MostrarToast("Información actualizada correctamente.", "info");
    }

