            _lineas = await CatalogCache.ObtenerLineasEmpaqueAsync(_noMaquinaSeleccionada);
            if (_lineas.Count > 0 && (string.IsNullOrEmpty(_nuevaLinea) || !_lineas.Any(l => l.LineaEmpaque == _nuevaLinea)))
            {
                _nuevaLinea = _lineas.First().LineaEmpaque;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar lneas: {ex.Message}");
        }
    }

