        // --- HELPER DE NORMALIZACIÓN DE HORA (Acepta 0810, 810, 08:10, 8) ---
    private static string NormalizarLinea(string? linea)
    {
        if (string.IsNullOrWhiteSpace(linea)) return "01";
        string limpio = linea.Trim();
        if (int.TryParse(limpio, out int num))
        {
            return num.ToString("D2");
        }
        return limpio.Length >= 2 ? limpio : limpio.PadLeft(2, '0');
    }

    private async Task EnfocarNuevaHoraAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "var el = document.getElementById('input-nueva-hora'); if(el){ el.focus(); el.select(); }");
        }
        catch { }
    }

    private string NormalizarHora(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return DateTime.Now.ToString("HH:mm");
        var s = input.Trim();
        if (s.Contains(":"))
        {
            var parts = s.Split(':');
            if (parts.Length == 2 && int.TryParse(parts[0], out int h) && int.TryParse(parts[1], out int m))
            {
                if (h >= 0 && h <= 23 && m >= 0 && m <= 59)
                    return $"{h:D2}:{m:D2}";
            }
        }
        string digits = new string(s.Where(char.IsDigit).ToArray());
        if (digits.Length == 4)
        {
            if (int.TryParse(digits.Substring(0, 2), out int h) && int.TryParse(digits.Substring(2, 2), out int m))
            {
                if (h >= 0 && h <= 23 && m >= 0 && m <= 59)
                    return $"{h:D2}:{m:D2}";
            }
        }
        else if (digits.Length == 3)
        {
            if (int.TryParse(digits.Substring(0, 1), out int h) && int.TryParse(digits.Substring(1, 2), out int m))
            {
                if (h >= 0 && h <= 23 && m >= 0 && m <= 59)
                    return $"{h:D2}:{m:D2}";
            }
        }
        else if (digits.Length == 1 || digits.Length == 2)
        {
            if (int.TryParse(digits, out int h) && h >= 0 && h <= 23)
            {
                return $"{h:D2}:00";
            }
        }
        return DateTime.Now.ToString("HH:mm");
    }

