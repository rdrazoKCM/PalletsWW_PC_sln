    private async Task SeleccionarVale(int folioVale, int idEncabezado)
    {
        try
        {
            var tDetalle = ValesService.ObtenerDetalleAsync(folioVale, idEncabezado);
            var tPallets = PalletsService.ObtenerPalletsPorValeAsync(folioVale, idEncabezado);

            await Task.WhenAll(tDetalle, tPallets);

            _valeActual = await tDetalle;
            _pallets = await tPallets ?? new();

            if (_valeActual != null)
            {
                _cajasPorPallet = _valeActual.CajasPorPallet > 0 ? _valeActual.CajasPorPallet : 63;
                _nuevasCajas = _cajasPorPallet;

                GenerarLoteItems(_loteItems.Count > 0 ? _loteItems.Count : 3);
                await ScrollTablaAlFinal();
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Error al seleccionar vale: {ex.Message}", "danger");
        }
    }

