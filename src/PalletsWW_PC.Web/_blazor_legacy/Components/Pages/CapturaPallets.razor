            _cargandoDatos = true;
            try
            {
                // Carga ultrarrápida en paralelo: catálogos cacheados en memoria (0ms) + datos activos de producción
                var tMaquinas = CatalogCache.ObtenerMaquinasAsync();
                var tLineas = CatalogCache.ObtenerLineasEmpaqueAsync(_noMaquinaSeleccionada);
                var tProductos = CatalogCache.ObtenerProductosPorMaquinaAsync(_noMaquinaSeleccionada);
                var tTurno = CargarTurnoYValesAsync();

                await Task.WhenAll(tMaquinas, tLineas, tProductos, tTurno);

                _maquinas = await tMaquinas;
                _lineas = await tLineas;
                if (_lineas.Count > 0 && string.IsNullOrEmpty(_nuevaLinea))
                {
                    _nuevaLinea = _lineas.First().LineaEmpaque;
                }
                _productosMaquina = await tProductos;
                if (_productosMaquina.Count > 0 && _nuevoProductoIdInput == 0)
                {
                    _nuevoProductoIdInput = _productosMaquina.First().IdtblProductos;
                }
            }
            catch (Exception ex)
            {
                MostrarToast($"Error al cargar datos de producción iniciales: {ex.Message}", "danger");
            }
            finally
            {
                _cargandoDatos = false;
            }
        }
        else
        {
            try
            {
                _maquinas = await CatalogCache.ObtenerMaquinasAsync();
            }
            catch { }
        }
        // Monitor en segundo plano para actualizar el turno en caliente (cada 20 min)
        _shiftCheckTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await VerificarCambioTurnoPeriodicoAsync();
            });
        }, null, TimeSpan.FromMinutes(20), TimeSpan.FromMinutes(20));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 0. SincronizaciÃ³n de Servidor Central: Mantener en localStorage la IP activa del host actual
            try
            {
                string currentHost = new Uri(Navigation.BaseUri).Host;
                if (!string.IsNullOrWhiteSpace(currentHost) &&
                    !string.Equals(currentHost, "localhost", StringComparison.OrdinalIgnoreCase) &&
                    !string.Equals(currentHost, "127.0.0.1", StringComparison.OrdinalIgnoreCase))
                {
                    await JS.InvokeVoidAsync("eval", $"try {{ localStorage.setItem('PalletsWW_ServerIp', '{currentHost}'); }} catch(e) {{}}");
                }
            }
            catch { }
            if (!MaquinaUrl.HasValue || MaquinaUrl.Value <= 0)
            {
                int mDetected = 0;
                try
                {
                    var mVal = await JS.InvokeAsync<string>("eval", @"(function() {
                        var m = document.cookie.match(/(?:^|;\s*)PalletsWW_Maquina=([^;]+)/);
                        if (m && parseInt(m[1]) > 0) return m[1];
                        return localStorage.getItem('PalletsWW_MaquinaId') || localStorage.getItem('pallets_ww_maquina') || '';
                    })()");

                    if (!string.IsNullOrWhiteSpace(mVal) && int.TryParse(mVal, out int mFast) && mFast > 0)
                    {
                        mDetected = mFast;
                    }
                }
                catch { }

                if (mDetected <= 0)
                {
                    try
                    {
                        var config = await JS.InvokeAsync<Configuracion.MachineConfigResult>("ZebraPrint.getMachineConfig", 1);
                        if (config != null && config.MachineId > 0)
                        {
                            mDetected = config.MachineId;
                        }
                    }
                    catch { }
                }

                if (mDetected > 0)
                {
                    _noMaquinaSeleccionada = mDetected;
                    try
                    {
                        await JS.InvokeVoidAsync("eval", $"document.cookie = 'PalletsWW_Maquina={_noMaquinaSeleccionada}; path=/; max-age=315360000; SameSite=Lax';");
                        Navigation.NavigateTo($"/?maquina={_noMaquinaSeleccionada}", replace: true);
                        return;
                    }
                    catch { }
                }
                else
                {
                    _valesDelTurno = new();
                    _valesTurnoAnterior = new();
                    _pallets = new();
                    _encabezadoActual = null;
                    MostrarToast("Terminal sin máquina asignada. Ingrese a Configuración para asignar la línea.", "warning");
                }
            }
            else
            {
                try
                {
                    await JS.InvokeVoidAsync("eval", $"document.cookie = 'PalletsWW_Maquina={_noMaquinaSeleccionada}; path=/; max-age=315360000; SameSite=Lax';");
                }
                catch { }
            }

            // Despachar verificación de hardware Zebra USB en segundo plano para no demorar la interfaz
            _ = Task.Run(async () =>
            {
                await Task.Delay(100);
                await InvokeAsync(async () =>
                {
                    await VerificarImpresoraUsbAsync();
                    StateHasChanged();
                });
            });

            await ScrollTablaAlFinal();
        }
    }
private static (int Turno, DateTime Fecha) ObtenerTurnoYFechaPlantaActual()
    {
        var ahora = DateTime.Now;
        var horaMin = ahora.TimeOfDay;

        if (horaMin >= new TimeSpan(7, 0, 0) && horaMin < new TimeSpan(15, 0, 0))
        {
            return (1, ahora.Date);
        }
        else if (horaMin >= new TimeSpan(15, 0, 0) && horaMin < new TimeSpan(23, 0, 0))
        {
            return (2, ahora.Date);
        }
        else
        {
            var f = horaMin < new TimeSpan(7, 0, 0) ? ahora.Date.AddDays(-1) : ahora.Date;
            return (3, f);
        }
    }

    private void CalcularTurnoYFechaPlanta()
    {
        var (t, f) = ObtenerTurnoYFechaPlantaActual();
        _turnoSeleccionado = t;
        _fechaSeleccionada = f;
    }

    private async Task VerificarCambioTurnoPeriodicoAsync()
    {
        if (_cargandoDatos || _isSaving || _guardandoEdicionId > 0 || _editingId > 0)
        {
            return;
        }

        // Si hay modales abiertos o dilogo de confirmacin, no interrumpir al operador
        if (_modalNuevoValeVisible || _modalModificarValeVisible || _modalReimpresionVisible || _confirmVisible)
        {
            return;
        }

        // Si el operador modific el campo de cajas en la captura rpida respecto al estndar, no interrumpir
        if (_nuevasCajas > 0 && _nuevasCajas != _cajasPorPallet)
        {
            return;
        }

        var (turnoEsperado, fechaEsperada) = ObtenerTurnoYFechaPlantaActual();

        if (turnoEsperado != _turnoSeleccionado || fechaEsperada != _fechaSeleccionada)
        {
            _turnoSeleccionado = turnoEsperado;
            _fechaSeleccionada = fechaEsperada;
            _esTurnoAnterior = false;
            _folioValeSeleccionado = 0;
            _valeActual = null;
            _pallets.Clear();

            await CargarTurnoYValesAsync();
            StateHasChanged();
        }
    }

    private static string ObtenerRangoTurno(int turno)
    {
        return turno switch
        {
            1 => "07:00 - 15:00",
            2 => "15:00 - 23:00",
            3 => "23:00 - 07:00",
            _ => "--:-- - --:--"
        };
    }

