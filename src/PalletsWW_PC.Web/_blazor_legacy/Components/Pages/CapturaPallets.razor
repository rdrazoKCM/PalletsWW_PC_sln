    private void AbrirModalNuevoVale()
    {
        EnriquecerClavesProductosMemoria();
        // 1. Calcular consecutivo automático del último vale registrado
        int maxVale = 0;
        if (_valesDelTurno.Count > 0)
        {
            maxVale = _valesDelTurno.Max(v => v.FolioVale);
        }
        if (_valesTurnoAnterior.Count > 0)
        {
            int maxAnt = _valesTurnoAnterior.Max(v => v.FolioVale);
            if (maxAnt > maxVale) maxVale = maxAnt;
        }
        if (_valeActual != null && _valeActual.FolioVale > maxVale)
        {
            maxVale = _valeActual.FolioVale;
        }

        if (maxVale > 0)
        {
            _nuevoFolioValeInput = maxVale + 1;
        }
        else
        {
            _nuevoFolioValeInput = null; // Vacío por default, sin cero
        }

        // 2. Producto sugerido
        if (_productosMaquina.Count > 0)
        {
            var prodSugerido = (_valeActual != null && _valeActual.IdtblProductos > 0)
                ? _productosMaquina.FirstOrDefault(p => p.IdtblProductos == _valeActual.IdtblProductos)
