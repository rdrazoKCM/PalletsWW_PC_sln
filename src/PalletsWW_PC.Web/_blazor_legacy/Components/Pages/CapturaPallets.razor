            if (prodSugerido != null)
            {
                _nuevoProductoIdInput = prodSugerido.IdtblProductos;
                _nuevoClaveProductoInput = prodSugerido.ClaveProducto;
            }
            else
            {
                _nuevoProductoIdInput = _productosMaquina.First().IdtblProductos;
                _nuevoClaveProductoInput = _productosMaquina.First().ClaveProducto;
            }
        }
        else
        {
            _nuevoProductoIdInput = 0;
            _nuevoClaveProductoInput = "";
        }
        _modalNuevoValeVisible = true;
    }

