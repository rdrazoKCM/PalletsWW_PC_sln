    private void GenerarLoteItems(int cantidad)
    {
        cantidad = Math.Clamp(cantidad, 1, 10);
        int cajasDefecto = _cajasPorPallet > 0 ? _cajasPorPallet : 63;
        string lineaDefecto = !string.IsNullOrEmpty(_nuevaLinea) ? _nuevaLinea : (_lineas.FirstOrDefault()?.LineaEmpaque ?? "01");
        
        _loteItems.Clear();
        var baseTime = DateTime.Now;

        for (int i = 0; i < cantidad; i++)
        {
            var itemTime = baseTime.AddMinutes(i);
            _loteItems.Add(new PalletBatchItemDto
            {
                FilaIndex = i + 1,
                TotalCajas = cajasDefecto,
                Hora = itemTime.ToString("HH:mm"),
                Linea = lineaDefecto
            });
        }
    }

    private void AgregarFilaLote()
    {
        if (_loteItems.Count >= 10)
        {
            MostrarToast("El lote ha alcanzado el límite máximo recomendado de 10 tarimas.", "warning");
            return;
        }

        int index = _loteItems.Count + 1;
        int cajasDefecto = _cajasPorPallet > 0 ? _cajasPorPallet : 63;
        string lineaDefecto = !string.IsNullOrEmpty(_nuevaLinea) ? _nuevaLinea : (_lineas.FirstOrDefault()?.LineaEmpaque ?? "01");
        var baseTime = _loteItems.Count > 0 && TimeSpan.TryParse(_loteItems.Last().Hora, out var lastTs)
            ? DateTime.Today.Add(lastTs).AddMinutes(1)
            : DateTime.Now;

        _loteItems.Add(new PalletBatchItemDto
        {
            FilaIndex = index,
            TotalCajas = cajasDefecto,
            Hora = baseTime.ToString("HH:mm"),
            Linea = lineaDefecto
        });
    }

    private void EliminarFilaLote(int filaIndex)
    {
        _loteItems.RemoveAll(x => x.FilaIndex == filaIndex);
        for (int i = 0; i < _loteItems.Count; i++)
        {
            _loteItems[i].FilaIndex = i + 1;
        }
    }

