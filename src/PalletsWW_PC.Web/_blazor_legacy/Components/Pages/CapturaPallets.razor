        _esTurnoAnterior = true;
        _folioValeSeleccionado = vale.FolioVale;
        int idEnc = vale.IdRT_Encabezado > 0 ? vale.IdRT_Encabezado : (_encabezadoActual?.IdRT_Encabezado ?? 0);
