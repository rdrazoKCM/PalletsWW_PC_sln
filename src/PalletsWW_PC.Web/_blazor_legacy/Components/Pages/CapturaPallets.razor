    private async Task GuardarEdicion(PalletDto p)
    {
        if (p == null || _guardandoEdicionId > 0) return;

        if (p.TotalCajas <= 0)
        {
            MostrarToast("El total de cajas debe ser mayor a 0.", "warning");
            return;
        }

        string horaNorm = NormalizarHora(p.Hora);
        p.Hora = horaNorm;

        string lineaNorm = NormalizarLinea(p.LineaEmpaque);

        // Validar si otra tarima en el vale ya tiene esa misma hora Y misma línea
        if (_pallets.Any(other => other.IdtblPallets != p.IdtblPallets && NormalizarHora(other.Hora) == horaNorm && NormalizarLinea(other.LineaEmpaque) == lineaNorm))
        {
            MostrarToast($"Operación rechazada: Ya existe otra tarima registrada con la hora {horaNorm} en la línea {lineaNorm} en este vale.", "warning");
            return;
        }

        _guardandoEdicionId = p.IdtblPallets;
        StateHasChanged();

        try
        {
            var updateDto = new PalletUpdateDto
            {
                IdtblPallets = p.IdtblPallets,
                TotalCajas = p.TotalCajas,
                Hora = p.Hora,
                Linea = p.LineaEmpaque
            };

            var res = await PalletsService.ActualizarPalletAsync(updateDto);
            if (res.Exitoso)
            {
                _editingId = 0;
                MostrarToast($"Pallet {p.IdtblPallets} modificado correctamente.", "success");
                if (_valeActual != null)
                {
                    int encId = _valeActual.IdRT_Encabezado > 0 ? _valeActual.IdRT_Encabezado : (_encabezadoActual?.IdRT_Encabezado ?? 0);
                    _pallets = await PalletsService.ObtenerPalletsPorValeAsync(_valeActual.FolioVale, encId);
                }
            }
            else
            {
                MostrarToast($"Error al modificar: {res.Mensaje}", "danger");
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Error inesperado: {ex.Message}", "danger");
        }
        finally
        {
            _guardandoEdicionId = 0;
            StateHasChanged();
        }
    }

