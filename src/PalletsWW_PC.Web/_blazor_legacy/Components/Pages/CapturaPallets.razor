    private async Task GuardarNuevoPallet()
    {
        if (_noMaquinaSeleccionada <= 0) { MostrarToast("No se puede guardar: Terminal sin máquina asignada. Ingrese a Configuración.", "danger"); return; }
        // 1. Candado atómico anti-doble enter / anti-doble clic (cooldown 1.5s)
        if (_isSaving || (DateTime.Now - _ultimoGuardadoMomento).TotalMilliseconds < 1500)
        {
            return;
        }
        _isSaving = true;
        _ultimoGuardadoMomento = DateTime.Now;

        try
        {
            if (_valeActual == null)
            {
                MostrarToast("Seleccione o cree un vale de producción antes de capturar pallets.", "warning");
                return;
            }

            if (_pallets.Count >= 38)
            {
                MostrarToast("Límite alcanzado: Este vale físico ya tiene 38 pallets registrados.", "danger");
                return;
            }

            if (!_operadorValido || !int.TryParse(_noEmpleadoInput, out int noEmp) || noEmp <= 0)
            {
                MostrarToast("Debe ingresar un número de empleado de operador válido.", "warning");
                return;
            }

            if (_nuevasCajas <= 0)
            {
                MostrarToast("La cantidad de cajas por tarima debe ser mayor a 0.", "warning");
                return;
            }

            string horaNorm = NormalizarHora(_nuevaHora);
            _nuevaHora = horaNorm;
            string lineaNorm = NormalizarLinea(_nuevaLinea);
            _nuevaHora = horaNorm;

            // Candado anti-duplicidad en captura individual: se permite la misma hora si la línea de empaque es distinta
            if (_pallets.Any(p => NormalizarHora(p.Hora) == horaNorm && NormalizarLinea(p.LineaEmpaque) == lineaNorm))
            {
                MostrarToast($"Operación cancelada: Ya existe una tarima registrada a las {horaNorm} en la línea {lineaNorm} para este vale. Verifique la hora o la línea.", "warning");
                return;
            }

            int encId = _valeActual.IdRT_Encabezado > 0 ? _valeActual.IdRT_Encabezado : (_encabezadoActual?.IdRT_Encabezado ?? 0);

            var insertDto = new PalletInsertDto
            {
                FolioVale = _valeActual.FolioVale,
                IdtblProductos = _valeActual.IdtblProductos,
                TotalCajas = _nuevasCajas,
                Hora = horaNorm,
                IdRT_Encabezado = encId,
                NoEmpCapturo = noEmp,
                Linea = _nuevaLinea
            };

            var res = await PalletsService.InsertarPalletAsync(insertDto);
            if (res.Exitoso)
            {
                _ultimoIdGuardado = res.IdtblPallets;

                // Enviar inmediatamente a la impresora Zebra USB local de la PC cliente
                await ImprimirEtiquetaUsb(res.IdtblPallets, res.CodigoZpl);

                _pallets = await PalletsService.ObtenerPalletsPorValeAsync(_valeActual.FolioVale, encId);
                _valesDelTurno = await ValesService.ObtenerActivosAsync(_noMaquinaSeleccionada, _turnoSeleccionado, _fechaSeleccionada, _encabezadoActual?.IdRT_Encabezado);
                if (_esTurnoAnterior)
                {
                    _valesTurnoAnterior = (await ValesService.ObtenerTurnoAnteriorAsync(_noMaquinaSeleccionada, _turnoSeleccionado, _fechaSeleccionada)).ToList();
                }

                _nuevaHora = DateTime.Now.ToString("HH:mm");

                MostrarToast($"Pallet {res.IdtblPallets} guardado y enviado a impresora Zebra USB.", "success");
                StateHasChanged();
                await Task.Delay(60);
                await ScrollTablaAlFinal();
            }
            else
            {
                MostrarToast($"Error al guardar: {res.Mensaje}", "danger");
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Error inesperado: {ex.Message}", "danger");
        }
        finally
        {
            _isSaving = false;
        }
    }
    private async Task GuardarLotePallets()
    {
        if (_noMaquinaSeleccionada <= 0) { MostrarToast("No se puede guardar: Terminal sin máquina asignada. Ingrese a Configuración.", "danger"); return; }
        if (_valeActual == null)
        {
            MostrarToast("Seleccione un vale de producción antes de capturar.", "warning");
            return;
        }

        if (_loteItems.Count == 0)
        {
            MostrarToast("Debe tener al menos una tarima configurada en el lote.", "warning");
            return;
        }

        if (_pallets.Count + _loteItems.Count > 38)
        {
            MostrarToast($"Límite excedido: Solo puede capturar {38 - _pallets.Count} tarima(s) más para este vale.", "danger");
            return;
        }

        if (!_operadorValido || !int.TryParse(_noEmpleadoInput, out int noEmp) || noEmp <= 0)
        {
            MostrarToast("Debe ingresar un número de empleado de operador válido.", "warning");
            return;
        }

        // 1. CANDADO PREVIO CLIENTE: Validar que no haya duplicados (hora y línea) entre las propias tarimas del lote
        _loteFilasConConflicto.Clear();
        _palletsConConflicto.Clear();

        var paresEnLote = new Dictionary<string, int>();
        bool conflictoInterno = false;
        string horaConflictoInterno = "";
        string lineaConflictoInterno = "";

        foreach (var item in _loteItems)
        {
            string hNorm = NormalizarHora(item.Hora);
            string lNorm = NormalizarLinea(item.Linea);
            item.Hora = hNorm;
            item.Linea = lNorm;
            string clave = $"{hNorm}_{lNorm}";
            if (paresEnLote.ContainsKey(clave))
            {
                _loteFilasConConflicto.Add(paresEnLote[clave]);
                _loteFilasConConflicto.Add(item.FilaIndex);
                conflictoInterno = true;
                horaConflictoInterno = hNorm;
                lineaConflictoInterno = lNorm;
            }
            else
            {
                paresEnLote[clave] = item.FilaIndex;
            }
        }

        if (conflictoInterno)
        {
            MostrarToast($"Operación cancelada: El lote contiene la hora {horaConflictoInterno} en la línea {lineaConflictoInterno} repetida en más de una tarima. Corrija las horas o líneas antes de guardar.", "danger");
            StateHasChanged();
            return;
        }

        // 2. CANDADO PREVIO CLIENTE: Validar que ningún par (hora, línea) coincida con las tarimas ya capturadas del vale activo
        bool conflictoVale = false;
        string horaConflictoVale = "";
        string lineaConflictoVale = "";
        string infoTarimaVale = "";

        foreach (var item in _loteItems)
        {
            string hNorm = NormalizarHora(item.Hora);
            string lNorm = NormalizarLinea(item.Linea);
            var pExistente = _pallets.FirstOrDefault(p => NormalizarHora(p.Hora) == hNorm && NormalizarLinea(p.LineaEmpaque) == lNorm);
            if (pExistente != null)
            {
                _loteFilasConConflicto.Add(item.FilaIndex);
                _palletsConConflicto.Add(pExistente.IdtblPallets);
                conflictoVale = true;
                horaConflictoVale = hNorm;
                lineaConflictoVale = lNorm;
                infoTarimaVale = !string.IsNullOrEmpty(pExistente.NoTarima) ? pExistente.NoTarima : $"ID {pExistente.IdtblPallets}";
            }
        }

        if (conflictoVale)
        {
            MostrarToast($"⚠️ Conflicto de hora y línea: La tarima del lote con hora {horaConflictoVale} en la línea {lineaConflictoVale} ya está registrada en este vale ({infoTarimaVale}). Modifique la hora o la línea.", "danger");
            StateHasChanged();
            return;
        }

        try
        {
            int encId = _valeActual.IdRT_Encabezado > 0 ? _valeActual.IdRT_Encabezado : (_encabezadoActual?.IdRT_Encabezado ?? 0);

            var batchDto = new PalletBatchInsertDto
            {
                FolioVale = _valeActual.FolioVale,
                IdtblProductos = _valeActual.IdtblProductos,
                IdRT_Encabezado = encId,
                NoEmpCapturo = noEmp,
                Pallets = _loteItems
            };

            var res = await PalletsService.InsertarLotePalletsAsync(batchDto);
            if (res.Exitoso)
            {
                // Impresion secuencial ordenada con pausa de 350ms directamente en el circuito Blazor
                if (res.PalletsInsertados != null && res.PalletsInsertados.Any(p => p.Exitoso))
                {
                    foreach (var p in res.PalletsInsertados.Where(x => x.Exitoso))
                    {
                        await ImprimirEtiquetaUsb(p.IdtblPallets, p.CodigoZpl);
                        await Task.Delay(350);
                    }
                }
                else if (res.IdsInsertados != null && res.IdsInsertados.Count > 0)
                {
                    foreach (var id in res.IdsInsertados)
                    {
                        await ImprimirEtiquetaUsb(id);
                        await Task.Delay(350);
                    }
                }

                _pallets = await PalletsService.ObtenerPalletsPorValeAsync(_valeActual.FolioVale, encId);
                _valesDelTurno = await ValesService.ObtenerActivosAsync(_noMaquinaSeleccionada, _turnoSeleccionado, _fechaSeleccionada, _encabezadoActual?.IdRT_Encabezado);
                if (_esTurnoAnterior)
                {
                    _valesTurnoAnterior = (await ValesService.ObtenerTurnoAnteriorAsync(_noMaquinaSeleccionada, _turnoSeleccionado, _fechaSeleccionada)).ToList();
                }

                MostrarToast($"¡Lote exitoso! {res.TotalGuardados} tarimas guardadas e impresas.", "success");
                SetModoCaptura(false);
                await ScrollTablaAlFinal();
            }
            else
            {
                if (res.IdsInsertados != null && res.IdsInsertados.Count > 0)
                {
                    foreach (var id in res.IdsInsertados)
                    {
                        await ImprimirEtiquetaUsb(id);
                        await Task.Delay(350);
                    }
                    _pallets = await PalletsService.ObtenerPalletsPorValeAsync(_valeActual.FolioVale, encId);
                }
                MostrarToast($"Error al guardar lote: {res.Mensaje}", "danger");
            }
        }
        catch (Exception ex)
        {
            MostrarToast($"Error inesperado: {ex.Message}", "danger");
        }
        finally
        {
            _isSaving = false;
        }
    }

