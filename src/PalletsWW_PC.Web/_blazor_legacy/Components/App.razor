<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pallets Wet Wipes - Planta Tlaxcala</title>
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css?v=20260925_18" />
    <link rel="stylesheet" href="bootstrap-icons/bootstrap-icons.min.css?v=20260925_18" />
    <link rel="stylesheet" href="app.css?v=20260925_18" />
